{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "composite": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@gestor/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts"
  ]
}
